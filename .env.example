# Copy to .env for local runs. Values here are the container-facing defaults.
DATABASE_URL=postgresql://policyiq:policyiq@postgres:5432/policyiq
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:3b-instruct
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
CHUNK_TARGET_CHARS=1200
CHUNK_OVERLAP_CHARS=150
RETRIEVAL_TOP_K=5
